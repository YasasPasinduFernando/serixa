{
    "name": "serixa/serixa",
    "description": "SERIXA ecosystem monorepo — local development meta-package (does not replace serixa/framework).",
    "type": "project",
    "license": "MIT",
    "private": true,
    "keywords": [
        "serixa",
        "monorepo"
    ],
    "authors": [
        {
            "name": "SERIXA Contributors"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "framework",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "starters/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "install-framework": "composer install --working-dir=framework --no-interaction",
        "post-install-cmd": [
            "@install-framework"
        ],
        "post-update-cmd": [
            "@install-framework"
        ],
        "test": "composer test --working-dir=framework --no-interaction",
        "phpstan": "composer phpstan --working-dir=framework --no-interaction",
        "cs-check": "composer cs-check --working-dir=framework --no-interaction",
        "cs-fix": "composer cs-fix --working-dir=framework --no-interaction",
        "qa": "composer qa --working-dir=framework --no-interaction",
        "test:packages": "php tools/scripts/test-packages.php",
        "test:starters": "php tools/scripts/test-starters.php",
        "benchmark": "php tools/benchmark/run.php"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
