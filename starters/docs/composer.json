{
    "name": "serixa/starter-docs",
    "description": "SERIXA starter kit: docs",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "serixa/framework": "^0.11"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": [
                "app/",
                "components/",
                "layouts/",
                "pages/"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
