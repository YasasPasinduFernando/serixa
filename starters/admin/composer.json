{
    "name": "serixa/starter-admin",
    "description": "Official SERIXA Admin Starter \u2014 production-ready administration panel scaffold (UI only).",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/YasasPasinduFernando/serixa",
    "support": {
        "issues": "https://github.com/YasasPasinduFernando/serixa/issues",
        "source": "https://github.com/YasasPasinduFernando/serixa",
        "docs": "https://github.com/YasasPasinduFernando/serixa/tree/main/docs"
    },
    "keywords": [
        "serixa",
        "php",
        "ui"
    ],
    "authors": [
        {
            "name": "SERIXA Contributors",
            "homepage": "https://github.com/YasasPasinduFernando/serixa"
        }
    ],
    "require": {
        "php": "^8.2",
        "serixa/framework": "*@dev",
        "serixa/icons": "*@dev",
        "serixa/admin": "*@dev",
        "serixa/forms": "*@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "App\\": [
                "app/",
                "components/",
                "layouts/",
                "pages/",
                "routes/"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../packages/icons",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../packages/admin",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../packages/forms",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": [
            "@test",
            "@phpstan",
            "@cs-check"
        ],
        "start": "php -S localhost:8000 -t public",
        "build": "php -r \"require 'vendor/autoload.php'; echo Serixa\\Assets\\StyleSheet::build(__DIR__)['bytes'], PHP_EOL;\""
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
