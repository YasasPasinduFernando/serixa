{
    "name": "serixa/starter-blog",
    "description": "Official SERIXA Blog Starter — production-ready blog CMS scaffold (UI only).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "serixa/framework": "*@dev",
        "serixa/icons": "*@dev",
        "serixa/admin": "*@dev",
        "serixa/forms": "*@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../packages/icons",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../packages/admin",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../packages/forms",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": ["app/", "components/", "layouts/", "pages/", "routes/"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": ["@test", "@phpstan", "@cs-check"],
        "start": "php -S localhost:8000 -t public"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
