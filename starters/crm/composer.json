{
    "name": "serixa/starter-crm",
    "description": "SERIXA CRM starter kit \u2014 dashboard shell for customer management apps.",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/YasasPasinduFernando/serixa",
    "support": {
        "issues": "https://github.com/YasasPasinduFernando/serixa/issues",
        "source": "https://github.com/YasasPasinduFernando/serixa",
        "docs": "https://github.com/YasasPasinduFernando/serixa/tree/main/docs"
    },
    "keywords": [
        "serixa",
        "php",
        "ui"
    ],
    "authors": [
        {
            "name": "SERIXA Contributors",
            "homepage": "https://github.com/YasasPasinduFernando/serixa"
        }
    ],
    "require": {
        "php": "^8.2",
        "serixa/framework": "^0.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": [
                "app/",
                "components/",
                "layouts/",
                "pages/"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
