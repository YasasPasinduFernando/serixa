{
    "name": "serixa/demo",
    "description": "SERIXA DX playground \u2014 consumes the local framework like a real app",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "serixa/framework": "*"
    },
    "autoload": {
        "psr-4": {
            "SerixaDemo\\": "app/",
            "SerixaDemo\\Pages\\": "pages/",
            "SerixaDemo\\Components\\": "components/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
