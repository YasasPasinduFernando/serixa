{
    "name": "serixa/demo",
    "description": "SERIXA DX playground \u2014 consumes the local framework like a real app",
    "type": "project",
    "license": "MIT",
    "homepage": "https://github.com/YasasPasinduFernando/serixa",
    "support": {
        "issues": "https://github.com/YasasPasinduFernando/serixa/issues",
        "source": "https://github.com/YasasPasinduFernando/serixa",
        "docs": "https://github.com/YasasPasinduFernando/serixa/tree/main/docs"
    },
    "keywords": [
        "serixa",
        "php",
        "ui"
    ],
    "authors": [
        {
            "name": "SERIXA Contributors",
            "homepage": "https://github.com/YasasPasinduFernando/serixa"
        }
    ],
    "require": {
        "php": "^8.2",
        "serixa/framework": "*"
    },
    "autoload": {
        "psr-4": {
            "SerixaDemo\\": "app/",
            "SerixaDemo\\Pages\\": "pages/",
            "SerixaDemo\\Components\\": "components/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
