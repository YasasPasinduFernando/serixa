{
    "name": "serixa/website",
    "description": "Official SERIXA documentation website — SSR docs, examples, and playground built with SERIXA.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "serixa/framework": "*@dev",
        "serixa/icons": "*@dev",
        "serixa/forms": "*@dev",
        "serixa/admin": "*@dev",
        "serixa/charts": "*@dev",
        "serixa/calendar": "*@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../packages/icons",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../packages/forms",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../packages/admin",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../packages/charts",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../packages/calendar",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": ["app/", "components/", "layouts/", "pages/", "routes/"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": ["@test", "@phpstan", "@cs-check"],
        "start": "php -S localhost:8080 -t public",
        "build": "php bin/build-assets.php",
        "sync-runtime": "php bin/sync-runtime.php"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
