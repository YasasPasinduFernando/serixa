{
    "name": "app/blog",
    "description": "Blog \u2014 SERIXA validation application",
    "type": "project",
    "require": {
        "php": "^8.2",
        "serixa/framework": "*@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\Pages\\": "pages/",
            "App\\Components\\": "components/",
            "App\\Layouts\\": "layouts/",
            "App\\Themes\\": "themes/",
            "App\\Plugins\\": "plugins/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
