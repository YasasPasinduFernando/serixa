{
    "name": "serixa/devtools",
    "description": "Official SERIXA developer tools \u2014 inspectors, collectors, overlay. Development only; never ship to production.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/YasasPasinduFernando/serixa",
    "support": {
        "issues": "https://github.com/YasasPasinduFernando/serixa/issues",
        "source": "https://github.com/YasasPasinduFernando/serixa",
        "docs": "https://github.com/YasasPasinduFernando/serixa/tree/main/docs"
    },
    "keywords": [
        "serixa",
        "devtools",
        "inspector",
        "profiler"
    ],
    "authors": [
        {
            "name": "SERIXA Contributors",
            "homepage": "https://github.com/YasasPasinduFernando/serixa"
        }
    ],
    "require": {
        "php": "^8.2",
        "serixa/framework": "*@dev",
        "serixa/cli": "*@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Serixa\\DevTools\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Serixa\\DevTools\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../cli",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": [
            "@test",
            "@phpstan",
            "@cs-check"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
