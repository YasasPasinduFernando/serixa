<?php

declare(strict_types=1);

use App\Layouts\AppLayout;
use App\Pages\HomePage;
use Serixa\Rendering\Renderer;

require dirname(__DIR__) . '/vendor/autoload.php';

$page = strtolower((string) ($_GET['page'] ?? 'home'));

$class = 'App\\Pages\\' . str_replace(' ', '', ucwords(str_replace(['-', '_'], ' ', $page))) . 'Page';

$document = ($page !== 'home' && class_exists($class) && is_callable([$class, 'document']))
    ? $class::document()
    : HomePage::document();

header('Content-Type: text/html; charset=utf-8');
echo (new Renderer())->render(AppLayout::wrap($document));
