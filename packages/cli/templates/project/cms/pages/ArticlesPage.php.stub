<?php

declare(strict_types=1);

namespace App\Pages;

use App\Layouts\AppLayout;
use Serixa\Component\Column;
use Serixa\Component\Text;
use Serixa\Document\Document;

/**
 * CMS articles overview.
 */
final class ArticlesPage
{
    public static function document(): Document
    {
        $body = Column::make([
            AppLayout::titleBar('Articles'),
            Text::make('Create and publish site content.')->tone('muted'),
        ])->gap(3);

        return Document::make()->title('Articles · {{ProjectName}}')->body($body);
    }
}
