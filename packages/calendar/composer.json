{
    "name": "serixa/calendar",
    "description": "Official SERIXA calendar — SSR calendar UI with progressive enhancement. UI only, no storage or sync.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "serixa",
        "calendar",
        "ssr",
        "datepicker"
    ],
    "authors": [
        {
            "name": "SERIXA Contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "serixa/framework": "*@dev",
        "serixa/icons": "*@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../icons",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Serixa\\Calendar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Serixa\\Calendar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": [
            "@test",
            "@phpstan",
            "@cs-check"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
