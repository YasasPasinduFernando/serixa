{
    "name": "serixa/forms",
    "description": "Official SERIXA forms package — validation, state, binding, and field helpers on top of framework controls.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "serixa",
        "forms",
        "validation",
        "ssr"
    ],
    "authors": [
        {
            "name": "SERIXA Contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "serixa/framework": "*@dev"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Serixa\\Forms\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Serixa\\Forms\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": [
            "@test",
            "@phpstan",
            "@cs-check"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
